  "power_balance": {
    "_설명": "전력 수지 계산에 쓰는 계측값. supply(들어오는 전력) 합 = demand(나가는 전력) 합 이어야 한다.",
    "supply_metrics": ["output_kw", "discharge_kw", "import_kw"],
    "demand_metrics": ["demand_kw", "charging_kw", "charge_kw", "export_kw"]
  }
